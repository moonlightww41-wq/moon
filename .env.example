# Server
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example

# LINE Messaging API
LINE_CHANNEL_SECRET=replace_me
LINE_CHANNEL_ACCESS_TOKEN=replace_me

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini

# Google auth option A: OAuth refresh token, usually easiest for personal Calendar/Drive
GOOGLE_OAUTH_CLIENT_ID=replace_me
GOOGLE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost
GOOGLE_OAUTH_REFRESH_TOKEN=replace_me

# Google auth option B: service account JSON. Use only if Calendar/Drive/Sheets are shared with it.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Default destinations
DEFAULT_CALENDAR_ID=primary
DRIVE_STAGING_FOLDER_ID=replace_me
PROCESSED_FOLDER_ID=replace_me

# Optional: keep PDF compression via CloudConvert
CLOUDCONVERT_API_KEY=

# Optional: Google Sheets for OCR/accounting logs later
SPREADSHEET_ID=
